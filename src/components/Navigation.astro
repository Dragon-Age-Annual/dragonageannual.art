                        target="_blank">Shipping and Delivery</a
                      >
                    </li>
                    <li>
                      <a
                        href="https://shop.dragonageannual.art/policies/terms"
                        target="_blank">Terms and Conditions</a
                      >
                    </li>
                  </ul>
                </div>
              </DropdownItems>
            </Dropdown>
          </li>
        </li>
      </ul>
    </MenuItems>
  </Astronav>

  <style>
    @reference "../styles/global.css";
    a,
    button {
      @apply hover:text-pink hover:underline hover:decoration-wavy hover:decoration-2 hover:underline-offset-3;
    }
    .dropdown {
      @apply text-teal-mid bg-arcane-300/98 dark:bg-arcane-600/99 border-gold absolute top-0 z-50 mt-3 rounded-md border p-5 shadow-xl/30;
    }

    li,
    .lightswitch {
      @apply ml-25 w-max border-0 lg:mt-1.5 lg:mr-1.5 lg:ml-0;
    }

    .dropdown li {
      @apply ml-0!;
    }
  </style>
