          <li>
            <a href="/past-years">Past Years</a>
          </li>
          <!-- Sales Dropdown -->
          <li>
            <Dropdown class="group">
              <button class="flex items-center">
                <span> Pre-Order</span>
                <Icon
                  name="pixelarticons:chevron-down"
                  class="mt-0.5 ml-1 h-4 w-4 group-open:rotate-180"
                />
              </button>
              <DropdownItems class="relative">
                <div class="dropdown">
                  <ul>
                    <li>
                      <a href="/community-copies">Community Copies</a>
                    </li>
                    <li>
                      <a href="https://shop.dragonageannual.art target=" _blank"
                        >Shop</a
                      >
                    </li>
                    <li>
                      <a
                        href="https://shop.dragonageannual.art/add-on-pack"
                        target="_blank">Add-on Packs</a
                      >
                    </li>
                    <li>
                      <a
                        href="https://shop.dragonageannual.art/compare-products"
                        target="_blank">Compare Products</a
