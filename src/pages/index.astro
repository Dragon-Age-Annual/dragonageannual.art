---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import CommunityCopyProgress from "../components/Communitycopyprogress.astro";
import About from "../components/About.astro";
import { Image } from "astro:assets";
import banner from "../assets/img/banner.png";
import ProjectInfo from "../components/ProjectInfo.astro";
import config from "../config.ts";

export const prerender = false;
---

<DefaultLayout
  title="Home"
  description="Dragon Age Annual: fan‑made charity calendar & merchandise. Seasonal pre‑orders champion causes, showcasing Thedas in art & fiction."
>
  <!-- SECTION: Main Content (Text + Sidebar) -->
  <section class="section">
    <div class="gap-10 lg:grid lg:grid-flow-row-dense lg:grid-cols-4">
      <!-- Main Text Column -->
      <div class="prose-daa lg:col-span-3">
        <CommunityCopyProgress />
        <Image
          src={banner}
          alt="Dragon Age Annual"
          class="mx-auto w-11/12 md:w-200"
        />
        <h1>2027 Pre-Orders Are Open!</h1>

        <p>
          Dragon Age Annual is back with our sixth installment! Inspired by the
          iconic locations that make Thedas a delight to explore, <em
            >Dragon Age Annual 2027: Destinations</em
          > is chock full of illustrations, writing, and merchandise that you won't
          want to miss out on. From Ostagar to The Lighthouse and beyond, if you love
          The Dragon Age Setting, this year's project is for you!
        </p>

        <p>
          Physical pre-orders will be open until September 30th and digital
          pre-orders will be open until January 31st. All proceeds go to support <a
            href="https://lakareutangranser.se/en/home">MSF Sweden</a
          >. Physical items, including the calendar, zine, and merchandise such
          as stickers & mini tarot cards, are available exclusively through
          pre-orders, so make sure to check out the offerings and secure yours
          before September 30th!
        </p>

        <p>
          Check out the <a
            href="https://shop.dragonageannual.art/product-gallery"
            >product gallery</a
          > and <a href="https://shop.dragonageannual.art/compare-products"
            >compare products</a
          > in our shop. You can purchase multiple packs in a single order, so mix-and-match
          to your heart's content, or add-on any of the extra merch packs that celebrate
          different races in Thedas to customize your order to your preferences! Don't
          forget to take a look at our <a
            href="https://shop.dragonageannual.art/stretch-goals"
            >stretch goals</a
          > for bonus items and upgrades that can be unlocked with your purchase.
        </p>

        <p>
          If you missed out on last year's installment, the tarot-inspired
          <em>Dragon Age Annual 2026: Arcana</em>, a limited run of those items
          are also available for purchase! Check out the <a
            href="https://placeholder.com">2026 Leftovers</a
          > listing and order fast—2026 orders are limited by the leftover items we
          have in stock, so when they're gone, they're gone.
        </p>

        <p>
          Also back this year are community copies—FREE copies of the Calendar &
          Zine PDFs paid for by donations from other fans. Even if you aren't in
          a position to buy right now, DAA 2027 is for you! See our shop for
          information on donating toward and claiming <a
            href="https://shop.dragonageannual.com/community-copies"
            >community copies.
          </a>
        </p>

        <p>
          Thank you all for supporting <em>Dragon Age Annual</em> over the past six
          years—this project is a labor of love by fans, for fans, and we couldn't
          do it without you!
        </p>
      </div>
      <!-- Sidebar Column -->
      <aside class="flex flex-col justify-center gap-y-5">
        <About />
        <ProjectInfo />
      </aside>
    </div>
    <!-- SECTION: Newsletter CTA -->
    <a name="newsletter"></a>
    <section id="newsletter" class="section mt-8! mb-4">
      <CallToAction />
    </section>
  </section>
</DefaultLayout>
